{
  "name": "Kate Platform",
  "build": {
    "dockerfile": "Dockerfile",
    "context": ".."
  },
  "features": {
    "ghcr.io/devcontainers/features/docker-outside-of-docker:1": {
      "version": "latest",
      "enableNonRootDocker": "true",
      "moby": "false"
    }
  },
  "remoteUser": "vscode",
  "mounts": [
    "source=kate-venv-gateway,target=${containerWorkspaceFolder}/services/gateway/.venv,type=volume",
    "source=kate-venv-auth-api,target=${containerWorkspaceFolder}/services/auth-api/.venv,type=volume",
    "source=kate-venv-orders-api,target=${containerWorkspaceFolder}/services/orders-api/.venv,type=volume",
    "source=kate-venv-report-api,target=${containerWorkspaceFolder}/services/report-api/.venv,type=volume",
    "source=kate-venv-chaos-portal,target=${containerWorkspaceFolder}/services/chaos-portal/.venv,type=volume",
    "source=kate-venv-worker,target=${containerWorkspaceFolder}/services/worker/.venv,type=volume",
    "source=kate-venv-loadgen,target=${containerWorkspaceFolder}/services/loadgen/.venv,type=volume"
  ],
  "forwardPorts": [3000, 8000, 8001, 8002, 8080, 8084, 8090, 9090, 10350],
  "postCreateCommand": "git config --global --add safe.directory ${containerWorkspaceFolder} && for svc in gateway auth-api orders-api report-api chaos-portal worker loadgen; do sudo chown -R vscode:vscode ${containerWorkspaceFolder}/services/$svc/.venv 2>/dev/null || true; echo \"→ uv sync: $svc\" && (cd ${containerWorkspaceFolder}/services/$svc && uv sync); done",
  "customizations": {
    "vscode": {
      "settings": {
        "editor.formatOnSave": true,
        "editor.rulers": [100],
        "[python]": {
          "editor.defaultFormatter": "charliermarsh.ruff"
        },
        "python.defaultInterpreterPath": "/usr/local/bin/python3.14",
        "mypy-type-checker.preferDaemon": false
      },
      "extensions": [
        "ms-python.python",
        "ms-python.mypy-type-checker",
        "charliermarsh.ruff",
        "ms-azuretools.vscode-docker",
        "ms-kubernetes-tools.vscode-kubernetes-tools",
        "redhat.vscode-yaml",
        "tamasfe.even-better-toml",
        "ms-vscode.makefile-tools",
        "tilt-dev.tiltfile"
      ]
    }
  }
}
