# Local-dev secrets / config. Copy to `.env` (gitignored) and fill in.
# Tiltfile parses this and passes the values to Helm via `--set`.
# Helm install will fail fast if any required key here is missing.

# Shared HS256 secret for JWT signing (auth-api) and verification (gateway).
# Must match across the two services or token validation breaks.
APP_JWT_SECRET=dev-secret-change-in-production

# Postgres passwords — one per service DB. Each backs both the bundled
# postgres pod's POSTGRES_PASSWORD and the app's APP_DATABASE_URL (assembled
# in the chart and exposed via a Secret).
APP_AUTH_DB_PASSWORD=auth
APP_ORDERS_DB_PASSWORD=orders
APP_REPORT_DB_PASSWORD=reports

# Redis password for the Celery broker. The Redis chart stores this in a
# Secret; report-api, worker, and KEDA consume the Secret by reference.
APP_REDIS_PASSWORD=redis

# Password used only by the synthetic Locust users created by loadgen.
LOADGEN_PASSWORD=DevLoadgenPassword1!

# Token for chaos-portal when deployed with auth.mode=token. Local Tilt dev
# runs auth.mode=dev so the UI is reachable through its port-forward without
# browser header injection.
CHAOS_TOKEN=dev-chaos-secret-change-in-production

# Grafana admin password for local dev. Refused at startup if empty.
GRAFANA_ADMIN_PASSWORD=dev-grafana-secret-change-in-production

# Loki tenant password for local dev. Refused at startup if empty.
LOKI_TENANT_PASSWORD=dev-loki-secret-change-in-production
