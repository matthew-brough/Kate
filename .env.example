# Local-dev secrets / config. Copy to `.env` (gitignored) and fill in.
# Tiltfile parses this and passes the values to Helm via `--set`.
# Helm install will fail fast if any required key here is missing.

# Shared HS256 secret for JWT signing (auth-api) and verification (gateway).
# Must match across the two services or token validation breaks.
APP_JWT_SECRET=dev-secret-change-in-production
